      "parameters": {
        "jsCode": "const d = $input.first().json.body ?? $input.first().json;\nconst req = ['tipo','titular','clinica','nif','localidad','email','telefono'];\nfor (const k of req) {\n  if (!d[k] || String(d[k]).trim() === '') throw new Error('Falta ' + k);\n}\nif (!['autonomo','sociedad'].includes(d.tipo)) throw new Error('tipo no valido');\n\nconst rnd = Math.random().toString(36).slice(2, 6).toUpperCase();\nconst id = `ALTA-${new Date().getFullYear()}-${rnd}`;\n\nreturn [{ json: {\n  id,\n  ...Object.fromEntries(req.map(k => [k, String(d[k]).trim().slice(0, 200)])),\n  estado: 'pendiente',\n  creado: new Date().toISOString()\n}}];"
      },
      "id": "ca74cf31-d279-4141-a8d5-cc3a1bef5f56",
