      "webhookId": "6b6b7451-c764-4a8d-9a4f-a6b290e6a90b"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst b = item.json.body ?? item.json;\nconst bin = Object.values(item.binary ?? {})[0];\n\nif (!bin) throw new Error('Sin archivo');\nif (!/^ALTA-\\d{4}-[A-Z0-9]{4}$/.test(b.id || '')) throw new Error('id no valido');\n\nconst OK = ['application/pdf','image/jpeg','image/png'];\nif (!OK.includes(bin.mimeType)) throw new Error('Tipo no permitido');\nif ((bin.fileSize ?? 0) > 10 * 1024 * 1024) throw new Error('Demasiado grande');\n\nconst doc = String(b.documento || '').replace(/[^a-z0-9-]/gi,'').slice(0,40);\nif (!doc) throw new Error('documento no valido');\nconst ext = {'application/pdf':'pdf','image/jpeg':'jpg','image/png':'png'}[bin.mimeType];\n\nconst prop = Object.keys(item.binary)[0];\nreturn [{ json: { ruta: `/data/expedientes/${b.id}/${doc}.${ext}`, prop }, binary: item.binary }];"
      },
      "id": "92cf3eb3-ad89-4ee5-88b1-3eff4c1322bf",
      "name": "Code",
