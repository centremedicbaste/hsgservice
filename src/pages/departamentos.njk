eleventyComputed:
  metaTitle: "Servicios para clínicas dentales | HSG Service"
  metaDescription: "Servicios de HSG Service para tu clínica dental: financiación, maquinaria, implantes, ortodoncia invisible, coaching y formación. Todo en un solo lugar."
  metaKeywords: "servicios clínicas dentales, financiación dental, maquinaria dental, implantes, ortodoncia invisible, coaching dental"
  metaRobots: "index, follow"
  breadcrumbs:
    - name: "Inicio"
