<li>
  <article class="post-card">
    <a href="{{ post.url }}" tabindex="-1" aria-hidden="true">
      <img class="post-card__img" src="{{ post.data.image }}" alt="{{ post.data.imageAlt }}" loading="lazy">
    </a>
    <div class="post-card__body">
      {% if post.data.categoria %}<span class="tag">{{ post.data.categoria }}</span>{% endif %}
      <h3 class="post-card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      <p class="t-small t-mute">{{ post.data.date | postDate }}</p>
      <p class="t-small">{{ post.data.description }}</p>
      <p class="mt-auto"><a class="link-arrow" href="{{ post.url }}">Leer más</a></p>
    </div>
  </article>
</li>
