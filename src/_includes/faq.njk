{% if faq %}
<section class="section bg-white">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Dudas frecuentes</span>
      <h2>Preguntas frecuentes</h2>
    </div>
    <div class="accordion">
      {% for item in faq %}
      <div class="accordion__item{% if loop.first %} is-open{% endif %}">
        <button class="accordion__head" type="button" aria-expanded="{{ 'true' if loop.first else 'false' }}">
          {{ item.q }}
        </button>
        <div class="accordion__panel"><p>{{ item.a }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
