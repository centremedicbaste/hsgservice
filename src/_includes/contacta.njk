{% import '_globals.njk' as globals %}
{% set heroSmall = true %}
{% include 'hero.njk' %}

<section class="section bg-white">
  <div class="container">
    <div class="grid grid--4">
      <div>
        <h2 class="t-h4">Direcciones</h2>
        <p class="t-small mt-4">
          {{ globals.direcciones[1].calle }}<br><br>
          {{ globals.direcciones[0].calle }}<br><br>
          {{ globals.direcciones[2].calle }}, Madrid
        </p>
      </div>
      <div>
        <h2 class="t-h4">Horario</h2>
        <p class="t-small mt-4">
          <strong>Lunes a jueves</strong><br>8:00–14:00 y 16:00–18:00<br><br>
          <strong>Viernes</strong><br>8:00–14:00<br><br>
          Sábado y domingo cerrado
        </p>
      </div>
      <div>
        <h2 class="t-h4">Email</h2>
        <p class="t-small mt-4"><a href="mailto:{{ global.email }}">{{ global.email }}</a></p>
      </div>
      <div>
        <h2 class="t-h4">Teléfonos</h2>
        <p class="t-small mt-4">
          <a href="tel:+34936612492">93 661 24 92</a><br>
          <a href="tel:+34637764576">637 764 576</a>
        </p>
      </div>
    </div>
  </div>
</section>

<div aria-hidden="false">
  <iframe title="Mapa de la sede de HSG Service en Avinguda Diagonal 442, Barcelona"
    style="width:100%;height:380px;border:0;display:block" loading="lazy"
