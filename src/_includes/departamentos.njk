---
layout: base.njk
title: Hsgservice | Plataforma de Servicios Odontológicos
eleventyComputed:
  metaTitle: "{{ title }} para clínicas | HSG Service"
  metaDescription: "{{ descripcion or global.seo_description }}"
  metaRobots: "index, follow"
  breadcrumbs:
    - name: "Inicio"
      url: "/"
    - name: "Departamentos"
      url: "/departamentos/"
    - name: "{{ title }}"
      url: "{{ page.url }}"
---
<article class="main-article  ">
  <div class="bg-dark has-light">{% include 'hero.njk' %} </div>
  <div class="front-section bg-white">
    <div class="container-11">
      <div class="innermarkdown pt-32 ">
        {{ content | safe }}</div>
    </div>
  </div>
  <div class="container-fluid l-top bg-white">
    <div class="col-xs-12">
      {% if next or previous%}
      <div class="pagination">
        {% if previous %}
        <a href="{{ previous.url }} " class="pagination-item pagination-item-prev">
          Previous post
        </a>
        {% endif %}
        {% if next %}
        <a href="{{ next.url }}" class="pagination-item pagination-item-next">
          Next post
        </a>
        {% endif %}
      </div>
      {% endif %}
    </div>
  </div>
  {% include "faq.njk" %}
  {% include "banner.njk" %}
</article>