---
layout: base.njk
title: Hsgservice | Plataforma de Servicios Odontológicos
eleventyComputed:
  metaTitle: "{{ title }} para clínicas | HSG Service"
  metaDescription: "{{ descripcion }}"
  metaRobots: "index, follow"
  breadcrumbs:
    - name: "Inicio"
      url: "/"
    - name: "Servicios"
      url: "/departamentos/"
    - name: "{{ title }}"
      url: "{{ page.url }}"
---
{% set heroSmall = true %}
{% include 'hero.njk' %}

<article class="section bg-white">
  <div class="container">
    {%- if ilustracion %}
    <img class="ilu-lead" src="/assets/static/ilustraciones/icono/{{ ilustracion }}.webp"
         alt="" width="360" height="360" loading="lazy">
    {%- endif %}
    <div class="prose">{{ content | safe }}</div>
  </div>
</article>

{% include "faq.njk" %}
