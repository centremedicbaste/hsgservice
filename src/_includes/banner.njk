{% import '_globals.njk' as globals %}
<section class="section bg-surface" id="seccioncontacta">
  <div class="container">
    <div class="grid grid--sidebar">

      <div class="banner__intro">
        <span class="eyebrow">Contacta</span>
        <h2>Hablemos de tu clínica</h2>
        <p class="t-lead mt-4">
          Envíanos el formulario y te responderemos lo antes posible.
          Ten el móvil cerca, porque te llamaremos.
        </p>
        <p class="mt-6"><strong>Tendrás un equipo de expertos trabajando para ti.</strong></p>

        <ul class="list-plain mt-6 t-small">
          <li><a href="mailto:{{ global.email }}">{{ global.email }}</a></li>
          <li>M. <a href="tel:+34637764576">637 76 45 76</a></li>
          <li>T. <a href="tel:+34936612492">93 661 24 92</a></li>
        </ul>
      </div>

      <div class="form-card">
        <form name="contactformulario" method="POST" action="/gracias/"
              data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contactformulario">
          <p hidden><label>No rellenar: <input name="bot-field"></label></p>

          <div class="field">
            <label for="nombre">Nombre</label>
            <input class="input" id="nombre" name="nombre" type="text" autocomplete="name" required>
          </div>

          <div class="field">
            <label for="clinica">Nombre de la clínica</label>
            <input class="input" id="clinica" name="clinica" type="text" autocomplete="organization" required>
          </div>

          <div class="field">
            <label for="consulta">Tipo de consulta</label>
            <div class="select">
              <select id="consulta" name="consulta">
                <option value="" disabled selected>Selecciona una opción</option>
                <option>Consulta general</option>
                <option>Central de compras</option>
                <option>Financiación</option>
                <option>Maquinaria y escáneres</option>
                <option>Masterclass Primeras visitas</option>
                <option>Masterclass Técnicas avanzadas</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required>
          </div>

          <div class="field">
            <label for="telefono">Teléfono</label>
            <input class="input" id="telefono" name="telefono" type="tel" autocomplete="tel">
          </div>

          <div class="field">
            <label for="mensaje">Tu mensaje</label>
            <textarea class="textarea" id="mensaje" name="mensaje"></textarea>
          </div>

          <div class="field">
            <label class="check">
              <input type="checkbox" name="politicas" required>
              <span>Acepto la <a href="/legal/politicas/">política de privacidad</a>.</span>
            </label>
          </div>

          <button class="btn btn--full" type="submit">Enviar</button>
        </form>
      </div>

    </div>
  </div>
</section>
