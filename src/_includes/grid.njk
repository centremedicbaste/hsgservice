---
layout: base.njk
title: tratamientos
eleventyComputed:
  metaTitle: "{{ title }} para clínicas | HSG Service"
  metaDescription: "{{ descripcion }}"
  metaRobots: "index, follow"
  breadcrumbs:
    - name: "Inicio"
      url: "/"
    - name: "Departamentos"
      url: "/departamentos/"
    - name: "{{ title }}"
      url: "{{ page.url }}"
---
{% set heroSmall = true %}
{% include 'hero.njk' %}

<article class="section bg-white">
  <div class="container">
    <div class="prose">{{ content | safe }}</div>
  </div>
</article>

{% set puntos = [grid1, grid2, grid3, grid4, grid6, grid7, grid8, grid9] %}
<section class="section bg-surface">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">En detalle</span>
      <h2>Qué incluye</h2>
    </div>
    <div class="grid grid--3">
      {% for punto in puntos %}
        {% if punto and punto != 'xx' %}
        <div class="card card--outline">
          <p>{{ punto }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% include "faq.njk" %}
{% include "banner.njk" %}
