---
layout: base.njk
---
{% set heroSmall = true %}
{% set eyebrow = categoria %}
{% include 'hero.njk' %}

<article class="section bg-white">
  <div class="container">
    <div class="prose">
      <p class="t-small t-mute">{{ page.date | postDate }}{% if author %} · {{ author }}{% endif %}</p>
      {{ content | safe }}
    </div>

    {% set next = collections.blog | nextInCollection(page.fileSlug) %}
    {% set previous = collections.blog | prevInCollection(page.fileSlug) %}
    {% if next or previous %}
    <nav class="prose mt-8" aria-label="Más artículos">
      <hr>
      <div class="grid grid--2">
        {% if previous %}<a class="link-arrow" href="{{ previous.url }}">{{ previous.data.title }}</a>{% endif %}
        {% if next %}<a class="link-arrow" href="{{ next.url }}">{{ next.data.title }}</a>{% endif %}
      </div>
    </nav>
    {% endif %}
  </div>
</article>

{% include "faq.njk" %}
{% include "banner.njk" %}
