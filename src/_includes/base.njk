<!DOCTYPE html>
<html lang="{{global.lang}}">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="{{global.search_console}}" />

  {# --- Título y descripción (con fallback al global) --- #}
  {%- set pageTitle = (metaTitle or title or global.seo_title) | trim -%}
  {%- set pageDescription = (metaDescription or description or global.seo_description) | trim -%}
  {%- set pageImage = global.website + (image or "/assets/static/home/gabinete-clinica-dental.webp") -%}
  {%- set pageUrl = global.website + (page.url | url) -%}

  <title>{{ pageTitle }}</title>
  <meta name="robots" content="{{ (metaRobots or 'index, follow') | trim }}">
  <meta name="description" content="{{ pageDescription }}">
  {% if metaKeywords %}<meta name="keywords" content="{{ metaKeywords | trim }}">{% endif %}
  <meta name="author" content="{{ global.empresa_legal }}">
  <meta name="theme-color" content="#013763">

  <link rel="canonical" href="{{ pageUrl }}">

  {# --- Iconos --- #}
  <link rel="icon" type="image/x-icon" href="/assets/static/favicons/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/static/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/static/favicons/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/assets/static/favicons/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  {# --- Imagen que mide el LCP ----------------------------------------------
     Solo en las paginas que declaran heroVisualSrcset en el front matter. Va
     delante de las fuentes a proposito: es lo que cronometra el LCP, y las
     tipografias llevan font-display:swap, asi que no retienen la pintura. #}
  {%- if heroVisualSrcset %}
  <link rel="preload" as="image" href="{{ heroVisual }}"
        imagesrcset="{{ heroVisualSrcset }}" imagesizes="{{ heroVisualSizes }}"
        fetchpriority="high">
  {%- endif %}

  {# --- Tipografía y hoja de estilos del design system ----------------------
     Se precargan los subconjuntos latinos de 400 y 700, que son los de la
     primera pantalla: cuerpo y titular. El 600 y los latin-ext se piden solo
     cuando hacen falta; precargarlos serian 86 KB compitiendo con la foto del
     hero, y el castellano entra entero en el subconjunto latino.

     La hoja va DENTRO del HTML, no en un <link>. El porque esta escrito en
     src/_data/estilos.js. #}
  <link rel="preload" href="/assets/fonts/source-sans-3/source-sans-3-latin-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/source-sans-3/source-sans-3-latin-700.woff2" as="font" type="font/woff2" crossorigin>
  <style>{{ estilos.ds | safe }}</style>

  {# --- Open Graph --- #}
  <meta property="og:site_name" content="HSG Service">
  <meta property="og:locale" content="es_ES">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ pageImage }}">

  {# --- Twitter Cards --- #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ pageImage }}">

  {# --- Datos estructurados (Schema.org) --- #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ global.website }}/#organization",
        "name": "HSG Service",
        "alternateName": ["HSG", "Grupo HSG", "HSG Services", "HSG Service Barcelona"],
        "legalName": "{{ global.empresa_legal }}",
        "url": "{{ global.website }}",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ global.website }}/assets/static/favicons/android-chrome-512x512.png",
          "width": 512,
          "height": 512
        },
        "description": "{{ global.seo_description }}",
        "email": "{{ global.email | trim }}",
        "telephone": "{{ global.telefono | trim }}",
        "vatID": "{{ global.empresa_dni }}",
        "foundingDate": "2012",
        "areaServed": { "@type": "Country", "name": "España" },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Diagonal, 442, 3º 2ª",
          "addressLocality": "Barcelona",
          "postalCode": "08037",
          "addressRegion": "Barcelona",
          "addressCountry": "ES"
        },
        "sameAs": [
          "{{ global.social_linkedin | trim }}",
          "{{ global.social_instagram | trim }}",
          "{{ global.social_youtube | trim }}"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "{{ global.website }}/#website",
        "url": "{{ global.website }}",
        "name": "HSG Service",
        "alternateName": "HSG",
        "inLanguage": "es-ES",
        "publisher": { "@id": "{{ global.website }}/#organization" }
      },
      {
        "@type": "ProfessionalService",
        "@id": "{{ global.website }}/#localbusiness",
        "name": "HSG Service",
        "image": "{{ global.website }}/assets/static/home/gabinete-clinica-dental.webp",
        "url": "{{ global.website }}",
        "telephone": "{{ global.telefono | trim }}",
        "email": "{{ global.email | trim }}",
        "priceRange": "€€",
        "parentOrganization": { "@id": "{{ global.website }}/#organization" },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Diagonal, 442, 3º 2ª",
          "addressLocality": "Barcelona",
          "postalCode": "08037",
          "addressRegion": "Barcelona",
          "addressCountry": "ES"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 41.3959,
          "longitude": 2.1441
        },
        "areaServed": ["Barcelona", "Madrid", "España"],
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
            "opens": "08:00", "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
            "opens": "16:00", "closes": "18:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Friday",
            "opens": "08:00", "closes": "14:00"
          }
        ]
      }{% if faq %},
      {
        "@type": "FAQPage",
        "@id": "{{ pageUrl }}#faq",
        "mainEntity": [
          {% for item in faq %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }{% endif %}{% if articleSchema %},
      {
        "@type": "BlogPosting",
        "@id": "{{ pageUrl }}#article",
        "headline": {{ title | dump | safe }},
        "description": {{ pageDescription | dump | safe }},
        "image": "{{ pageImage }}",
        "datePublished": "{% if page.date %}{{ page.date.toISOString() }}{% endif %}",
        "dateModified": "{% if page.date %}{{ page.date.toISOString() }}{% endif %}",
        "inLanguage": "es-ES",
        "author": { "@id": "{{ global.website }}/#organization" },
        "publisher": { "@id": "{{ global.website }}/#organization" },
        "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ pageUrl }}" }
      }{% endif %}{% if breadcrumbs and breadcrumbs.length %},
      {
        "@type": "BreadcrumbList",
        "@id": "{{ pageUrl }}#breadcrumb",
        "itemListElement": [
          {% for crumb in breadcrumbs %}
          {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "name": {{ crumb.name | dump | safe }},
            "item": "{{ global.website }}{{ crumb.url }}"
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }{% endif %}{% if service %},
      {
        "@type": "Service",
        "@id": "{{ pageUrl }}#service",
        "name": {{ service.name | dump | safe }},
        "serviceType": {{ service.tipo | dump | safe }},
        "description": {{ pageDescription | dump | safe }},
        "url": "{{ pageUrl }}",
        "provider": { "@id": "{{ global.website }}/#organization" },
        "areaServed": { "@type": "Country", "name": "España" },
        "audience": {
          "@type": "BusinessAudience",
          "name": {{ service.publico | dump | safe }}
        }
      }{% endif %}
    ]
  }
  </script>

  {% set cfg = global %}
  {% include 'atribucion.njk' %}
  {% include 'measurement.njk' %}
  {% include 'pixel-meta.njk' %}
</head>


<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  {% include 'header.njk' %}
  <main id="contenido">
    {{ content | safe }}
  </main>
  {% include 'footer.njk' %}
  {% include 'consentimiento.njk' %}
  <script src="/assets/js/ui.js?v={{ activos.ui }}" defer></script>
  {% if global.ga4_id %}<script src="/assets/js/consentimiento.js?v={{ activos.consentimiento }}" defer></script>{% endif %}
  <script>
    const handleSubmit = (event) => {
      event.preventDefault();
      const myForm = event.target;
      const formData = new FormData(myForm);
      fetch("/", {
        method: "POST",
        headers: {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        body: new URLSearchParams(formData).toString()
      })
        .then(() => console.log("Form successfully submitted"))
        .catch((error) => alert(error));
    };
  </script>
</body>
</html>