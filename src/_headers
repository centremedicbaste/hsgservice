# Cabeceras que sirve Netlify. Un fichero por sitio, un bloque por patrón.
#
# Sin este fichero Netlify manda todo con "max-age=0, must-revalidate", o sea
# que el navegador vuelve a preguntar por cada fichero en cada navegación.
# Aquí se le dice cuánto puede guardarse cada cosa.
#
# El HTML se queda fuera a propósito: no lleva Cache-Control, así que sigue
# revalidándose siempre y un despliegue se ve al momento.

/*
  # El navegador respeta el Content-Type declarado y no lo adivina.
  X-Content-Type-Options: nosniff
  # Nadie puede meter el sitio en un iframe ajeno (clickjacking).
  X-Frame-Options: SAMEORIGIN
  # Al salir a otro dominio solo viaja el origen, nunca la ruta completa.
  Referrer-Policy: strict-origin-when-cross-origin
  # El sitio no usa ninguna de estas APIs: se deniegan de forma explícita.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Las fuentes no cambian jamás sin cambiar de nombre: un año e inmutables,
# que ahorra incluso la petición condicional.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Netlify aplica la ÚLTIMA regla que casa, no la más específica: por eso
# /assets/static/video/* va después de /assets/static/*.
# Imágenes, iconos y favicons: 30 días. Ojo: si sustituyes una imagen
# conservando el nombre, quien ya la tenga tardará hasta un mes en ver la
# nueva. Renómbrala y se ve al instante.
/assets/static/*
  Cache-Control: public, max-age=2592000

# Los vídeos pesan mucho y se sustituyen renombrando, nunca editando el mismo
# fichero. Un año.
/assets/static/video/*
  Cache-Control: public, max-age=31536000, immutable

# El CSS ya no se pide: va dentro del HTML (ver src/_data/estilos.js). El
# fichero se sigue publicando por si algún navegador guarda un HTML viejo que
# lo enlaza, y por eso se queda en una hora: no lleva huella en la URL.
/assets/css/*
  Cache-Control: public, max-age=3600

# El JS sí lleva huella: las plantillas lo piden como ui.js?v=3f9a1c2b, con el
# sha1 del contenido, así que la URL cambia sola cuando cambia el fichero. Eso
# permite el año e inmutable sin riesgo de servir una versión vieja.
# OJO: un <script> nuevo SIN su ?v={{ activos.<nombre> }} se quedaría pegado en
# el navegador del visitante durante un año.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
